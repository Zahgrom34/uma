# Local development defaults. On Railway these are set as service variables instead.
DATABASE_URL="file:../data/uma.db"
ADMIN_EMAIL=admin@umabrand.uz
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me
MEDIA_BASE_URL=http://localhost:3001
# Extra allowed origin for the credentialed admin API (the storefront's public
# content endpoint is CORS-open and does not need this).
CORS_ORIGIN=https://example.github.io
PORT=3001
NODE_ENV=development
# Optional: override where uploaded media is stored (defaults to ./uploads).
# UPLOADS_DIR=/data/uploads
